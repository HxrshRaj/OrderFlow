# Copy this file to .env (gitignored - see the repo's root .gitignore) and fill in real values.
# Never commit .env or paste real tokens into commit messages, code, or issue text.

# Your Atlassian Cloud site, e.g. https://your-domain.atlassian.net
JIRA_SITE_URL=https://your-domain.atlassian.net

# The Atlassian account email the API token below belongs to.
JIRA_EMAIL=you@example.com

# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=paste-your-api-token-here

# The project OrderFlow tickets should be filed under (its key, not its name), e.g. OF.
JIRA_PROJECT_KEY=OF

# Optional: override if your project's template doesn't have a "Bug" issue type
# (the script auto-detects and falls back to "Task" if "Bug" isn't available).
JIRA_ISSUE_TYPE=Bug
